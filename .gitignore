# macOS and editor noise
.DS_Store
*~
*.swp
*.swo

# R session and local project state
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Rproj.user/

# Python/Jupyter environments and caches
.venv/
venv/
env/
jupyter-env/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Quarto/knitr render artifacts
.cache/
.quarto/
_site/
*_cache/
*_files/
*.html
*.log
logs/
log/

# renv library is local; the lockfile is committed.
renv/
!renv.lock

# Raw input data are intentionally not versioned.
data/**
!data/
!data/README.md
!data/Hg19/
!data/Hg19/.gitkeep
!data/Hg38/
!data/Hg38/.gitkeep

# Keep compact result summaries, mapping provenance, diagnostics, and figures.
# Large target matrices and run logs should be regenerated or archived externally.
results/**
!results/
!results/*/
!results/*/figures/
!results/*/figures/*.pdf
!results/*/figures/*.png
!results/*/target_summary.tsv
!results/*/te_contrast_summary.tsv
!results/*/*_signif_act.tsv
!results/*/activity_scores.tsv
!results/*/activity_fit_summary.tsv
!results/*/activity_lambda_diagnostics.tsv
!results/*/sample_activity_diagnostics.tsv
!results/*/signif_model_diagnostics.tsv
!results/*/mapping/
!results/*/mapping/*.tsv
!results/*/mapping/*.html
!results/*/mapping/diagnostics/
!results/*/mapping/diagnostics/*.tsv
!results/*/exploratory/
!results/*/exploratory/most_active_te_subfamilies/
!results/*/exploratory/most_active_te_subfamilies/*.tsv

# GitHub rejects normal Git blobs above 100 MB.
results/**/target_gene_matrix_*.tsv
